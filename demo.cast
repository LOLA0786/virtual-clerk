[0.410, "o", "\u001b[22A\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mw\u001b[27mi\u001b[27mt\u001b[27mh\u001b[27m \u001b[27mp\u001b[27md\u001b[27mf\u001b[27mp\u001b[27ml\u001b[27mu\u001b[27mm\u001b[27mb\u001b[27me\u001b[27mr\u001b[27m.\u001b[27mo\u001b[27mp\u001b[27me\u001b[27mn\u001b[27m(\u001b[27mf\u001b[27mi\u001b[27ml\u001b[27me\u001b[27m)\u001b[27m \u001b[27ma\u001b[27ms\u001b[27m \u001b[27mp\u001b[27md\u001b[27mf\u001b[27m:\u001b[1B\r\u001b[63P\u001b[12Cfor page_no, page in enumerate(pdf.pages, start=1):\u001b[K\u001b[1B\r\u001b[M\u001b[16Ctext = page.extract_text() or \"\"\u001b[1B\r\u001b[K\u001b[1B\u001b[50P\u001b[16Cif CASE_NUMBER in text:\u001b[K\u001b[1B\r\u001b[45P\u001b[20Cprint(f\"\\n✅ FOUND in {file}\")\u001b[K\u001b[1B\r\u001b[37P\u001b[20Cprint(f\"Page: {page_no}\")\u001b[K\u001b[1B\r\u001b[31P\u001b[20Cprint(text[:300])\u001b[12C\u001b[K\u001b[1B\r\u001b[26P\u001b[20Creturn True\u001b[23C\u001b[K\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27me\u001b[27mx\u001b[27mc\u001b[27me\u001b[27mp\u001b[27mt\u001b[27m \u001b[27mE\u001b[27mx\u001b[27mc\u001b[27me\u001b[27mp\u001b[27mt\u001b[27mi\u001b[27mo\u001b[27mn\u001b[27m \u001b[27ma\u001b[27ms\u001b[27m \u001b[27me\u001b[27m:\u001b[K\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mp\u001b[27mr\u001b[27mi\u001b[27mn\u001b[27mt\u001b[27m(\u001b[27mf\u001b[27m\"Skipping {file} (not valid PDF)\")\u001b[1B\u001b[45Dreturn False\u001b[1B\r\u001b[K\u001b[1Bpdfs = Path(\".\").glob(\"*.pdf\")\u001b[1B\r\u001b[K\u001b[1B\u001b[27mf\u001b[27mo\u001b[27mu\u001b[27mn\u001b[27md\u001b[27m \u001b[27m=\u001b[27m \u001b[27mF\u001b[27ma\u001b[27m"]
