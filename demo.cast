[1.098, "o", ">....                                         \r\n\u001b[7m    print(\"Saved cause_list.pdf\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mdef search_case(case_number):\u001b[27m\u001b[K\r\r\n\u001b[7m    with pdfplumber.open(PDF_FILE) as pdf:\u001b[27m\u001b[K\r\r\n\u001b[7m        for page_number, page in enumerate(pdf.pages, start=1):\u001b[27m\u001b[K\r\r\n\u001b[7m            text = page.extract_text()\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m            if case_number in text:\u001b[27m\u001b[K\r\r\n\u001b[7m                return page_number, text\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    return None, None\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mif __name__ == \"__main__\":\u001b[27m\u001b[K\r\r\n\u001b[7m    download_cause_list()\u001b[27m\u001b[K\r\r\n\u001b[7m    page, text = search_case(\"WP-1234-2024\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    if page:\u001b[27m\u001b[K\r\r\n\u001b[7m        print(f\"Found on page {page}\")\u001b[27m\u001b[K\r\r\n\u001b[7m    else:\u001b[27m\u001b[K\r\r\n\u001b[7m        print(\"Case not listed\")\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.343, "o", "\u001b[22A\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mp\u001b[27mr\u001b[27mi\u001b[27mn\u001b[27mt\u001b[27m(\u001b[27m\"\u001b[27mS\u001b[27ma\u001b[27mv\u001b[27me\u001b[27md\u001b[27m \u001b[27mc\u001b[27ma\u001b[27mu\u001b[27ms\u001b[27me\u001b[27m_\u001b[27ml\u001b[27mi\u001b[27ms\u001b[27mt\u001b[27m.\u001b[27mp\u001b[27md\u001b[27mf\u001b[27m\"\u001b[27m)\u001b[3B\r\u001b[27md\u001b[27me\u001b[27mf\u001b[27m \u001b[27ms\u001b[27me\u001b[27ma\u001b[27mr\u001b[27mc\u001b[27mh\u001b[27m_\u001b[27mc\u001b[27ma\u001b[27ms\u001b[27me\u001b[27m(\u001b[27mc\u001b[27ma\u001b[27ms\u001b[27me\u001b[27m_\u001b[27mn\u001b[27mu\u001b[27mm\u001b[27mb\u001b[27me\u001b[27mr\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mw\u001b[27mi\u001b[27mt\u001b[27mh\u001b[27m \u001b[27mp\u001b[27md\u001b[27mf\u001b[27mp\u001b[27ml\u001b[27mu\u001b[27mm\u001b[27mb\u001b[27me\u001b[27mr\u001b[27m.\u001b[27mo\u001b[27mp\u001b[27me\u001b[27mn\u001b[27m(\u001b[27mP\u001b[27mD\u001b[27mF\u001b[27m_\u001b[27mF\u001b[27mI\u001b[27mL\u001b[27mE\u001b[27m)\u001b[27m \u001b[27ma\u001b[27ms\u001b[27m \u001b[27mp\u001b[27md\u001b[27mf\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mf\u001b[27mo\u001b[27mr\u001b[27m \u001b[27mp\u001b[27ma\u001b[27mg\u001b[27me\u001b[27m_\u001b[27mn\u001b[27mu\u001b[27mm\u001b[27mb\u001b[27me\u001b[27mr\u001b[27m,\u001b[27m \u001b[27mp\u001b[27ma\u001b[27mg\u001b[27me\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m \u001b[27me\u001b[27mn\u001b[27mu\u001b[27mm\u001b[27me\u001b[27mr\u001b[27ma\u001b[27mt\u001b[27me\u001b[27m(\u001b[27mp\u001b[27md\u001b[27mf\u001b[27m.\u001b[27mp\u001b[27ma\u001b[27mg\u001b[27me\u001b[27ms\u001b[27m,\u001b[27m \u001b[27ms\u001b[27mt\u001b[27ma\u001b[27mr\u001b[27mt\u001b[27m=\u001b[27m1\u001b[27m)\u001b[27m:\u001b"]
[0.000, "o", "[1B\r\u001b[38P\u001b[12Ctext = page.extract_text()\u001b[4C\u001b[K\u001b[2B\r\u001b[35P\u001b[12Cif case_number in text:\u001b[10C\u001b[K\u001b[1B\r\u001b[M\u001b[16Creturn page_number, text\u001b[1B\r\u001b[K\u001b[1B\u001b[4Creturn None, None\u001b[2B\r\u001b[K\u001b[1B\u001b[27mi\u001b[27mf\u001b[27m \u001b[27m_\u001b[27m_\u001b[27mn\u001b[27ma\u001b[27mm\u001b[27me\u001b[27m_\u001b[27m_\u001b[27m \u001b[27m=\u001b[27m=\u001b[27m \u001b[27m\"\u001b[27m_\u001b[27m_\u001b[27mm\u001b[27ma\u001b[27mi\u001b[27mn\u001b[27m_\u001b[27m_\u001b[27m\":\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27md\u001b[27mo\u001b[27mw\u001b[27mn\u001b[27ml\u001b[27mo\u001b[27ma\u001b[27md\u001b[27m_\u001b[27mc\u001b[27ma\u001b[27mu\u001b[27ms\u001b[27me\u001b[27m_\u001b[27ml\u001b[27mi\u001b[27ms\u001b[27mt\u001b[27m(\u001b[27m)\u001b[K\u001b[1B\u001b[21Dpage, text = search_case(\"WP-1234-2024\")\u001b[1B\r\u001b[K\u001b[1B\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mi\u001b[27mf\u001b[27m \u001b[27mp\u001b[27ma\u001b[27mg\u001b[27me\u001b[27m:\u001b[K\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mprint(f\"Found on page {page}\")\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27me\u001b[27ml\u001b[27ms\u001b[27me\u001b[27m:\u001b[K\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[5Cprint(\"Case not listed\")\u001b[1B\rEOF\u001b[K"]
