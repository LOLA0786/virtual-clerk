[5.196, "o", ">....                                         \r\n\u001b[7mdef mock_fetch_status():\u001b[27m\u001b[K\r\r\n\u001b[7m    return {\u001b[27m\u001b[K\r\r\n\u001b[7m        \"next_date\": (datetime.now().date()).isoformat(),\u001b[27m\u001b[K\r\r\n\u001b[7m        \"judge\": random.choice([\"Justice Kulkarni\",\"Justice Patel\"]),\u001b[27m\u001b[K\r\r\n\u001b[7m        \"stage\": random.choice([\"Admission\",\"Final Hearing\"]),\u001b[27m\u001b[K\r\r\n\u001b[7m        \"courtroom\": random.randint(10,60)\u001b[27m\u001b[K\r\r\n\u001b[7m    }\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mdef check_updates():\u001b[27m\u001b[K\r\r\n\u001b[7m    data = load()\u001b[27m\u001b[K\r\r\n\u001b[7m    alerts = []\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    for case, info in data.items():\u001b[27m\u001b[K\r\r\n\u001b[7m        new = mock_fetch_status()\u001b[27m\u001b[K\r\r\n\u001b[7m        old = info.get(\"last_status\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m        if old != new:\u001b[27m\u001b[K\r\r\n\u001b[7m            alerts.append((case,new))\u001b[27m\u001b[K\r\r\n\u001b[7m            info[\"last_status\"] = new\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    save(data)\u001b[27m\u001b[K\r\r\n\u001b[7m    return alerts\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.353, "o", "\u001b[22A\r\u001b[27md\u001b[27me\u001b[27mf\u001b[27m \u001b[27mm\u001b[27mo\u001b[27mc\u001b[27mk\u001b[27m_\u001b[27mf\u001b[27me\u001b[27mt\u001b[27mc\u001b[27mh\u001b[27m_\u001b[27ms\u001b[27mt\u001b[27ma\u001b[27mt\u001b[27mu\u001b[27ms\u001b[27m(\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mr\u001b[27me\u001b[27mt\u001b[27mu\u001b[27mr\u001b[27mn\u001b[27m \u001b[27m{\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m\"\u001b[27mn\u001b[27me\u001b[27mx\u001b[27mt\u001b[27m_\u001b[27md\u001b[27ma\u001b[27mt\u001b[27me\u001b[27m\"\u001b[27m:\u001b[27m \u001b[27m(\u001b[27md\u001b[27ma\u001b[27mt\u001b[27me\u001b[27mt\u001b[27mi\u001b[27mm\u001b[27me\u001b[27m.\u001b[27mn\u001b[27mo\u001b[27mw\u001b[27m(\u001b[27m)\u001b[27m.\u001b[27md\u001b[27ma\u001b[27mt\u001b[27me\u001b[27m(\u001b[27m)\u001b[27m)\u001b[27m.\u001b[27mi\u001b[27ms\u001b[27mo\u001b[27mf\u001b[27mo\u001b[27mr\u001b[27mm\u001b[27ma\u001b[27mt\u001b[27m(\u001b[27m)\u001b[27m,\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m\"\u001b[27mj\u001b[27mu\u001b[27md\u001b[27mg\u001b[27me\u001b[27m\"\u001b[27m:\u001b[27m \u001b[27mr\u001b[27ma\u001b[27mn\u001b[27md\u001b[27mo\u001b[27mm\u001b[27m.\u001b[27mc\u001b[27mh\u001b[27mo\u001b[27mi\u001b[27mc\u001b[27me\u001b[27m(\u001b[27m[\u001b[27m\"\u001b[27mJ\u001b[27mu\u001b[27ms\u001b[27mt\u001b[27mi\u001b[27mc\u001b[27me\u001b[27m \u001b[27mK\u001b[27mu\u001b[27ml\u001b[27mk\u001b[27ma\u001b[27mr\u001b[27mn\u001b[27mi\u001b[27m\"\u001b[27m,\u001b[27m\"\u001b[27mJ\u001b[27mu\u001b[27ms\u001b[27mt\u001b[27mi\u001b[27mc\u001b[27me\u001b[27m \u001b[27mP\u001b[27ma\u001b[27mt\u001b[27me\u001b[27ml\u001b[27m\"\u001b[27m]\u001b[27m)\u001b[27m,\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b["]
[0.000, "o", "27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m\"\u001b[27ms\u001b[27mt\u001b[27ma\u001b[27mg\u001b[27me\u001b[27m\"\u001b[27m:\u001b[27m \u001b[27mr\u001b[27ma\u001b[27mn\u001b[27md\u001b[27mo\u001b[27mm\u001b[27m.\u001b[27mc\u001b[27mh\u001b[27mo\u001b[27mi\u001b[27mc\u001b[27me\u001b[27m(\u001b[27m[\u001b[27m\"\u001b[27mA\u001b[27md\u001b[27mm\u001b[27mi\u001b[27ms\u001b[27ms\u001b[27mi\u001b[27mo\u001b[27mn\u001b[27m\"\u001b[27m,\u001b[27m\"\u001b[27mF\u001b[27mi\u001b[27mn\u001b[27ma\u001b[27ml\u001b[27m \u001b[27mH\u001b[27me\u001b[27ma\u001b[27mr\u001b[27mi\u001b[27mn\u001b[27mg\u001b[27m\"\u001b[27m]\u001b[27m)\u001b[27m,\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m\"\u001b[27mc\u001b[27mo\u001b[27mu\u001b[27mr\u001b[27mt\u001b[27mr\u001b[27mo\u001b[27mo\u001b[27mm\u001b[27m\"\u001b[27m:\u001b[27m \u001b[27mr\u001b[27ma\u001b[27mn\u001b[27md\u001b[27mo\u001b[27mm\u001b[27m.\u001b[27mr\u001b[27ma\u001b[27mn\u001b[27md\u001b[27mi\u001b[27mn\u001b[27mt\u001b[27m(\u001b[27m1\u001b[27m0\u001b[27m,\u001b[27m6\u001b[27m0\u001b[27m)\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m}\u001b[2B\r\u001b[27md\u001b[27me\u001b[27mf\u001b[27m \u001b[27mc\u001b[27mh\u001b[27me\u001b[27mc\u001b[27mk\u001b[27m_\u001b[27mu\u001b[27mp\u001b[27md\u001b[27ma\u001b[27mt\u001b[27me\u001b[27ms\u001b[27m(\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27md\u001b[27ma\u001b[27mt\u001b[27ma\u001b[27m \u001b[27m=\u001b[27m \u001b[27ml\u001b[27mo\u001b[27ma\u001b[27md\u001b[27m(\u001b[27m)\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27ma\u001b[27ml\u001b[27me\u001b[27mr\u001b[27mt\u001b[27ms\u001b[27m \u001b[27m=\u001b[27m \u001b[27m[\u001b[27m]\u001b[2B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mf\u001b[27mo\u001b[27mr\u001b[27m \u001b[27mc"]
[0.001, "o", "\u001b[27ma\u001b[27ms\u001b[27me\u001b[27m,\u001b[27m \u001b[27mi\u001b[27mn\u001b[27mf\u001b[27mo\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m \u001b[27md\u001b[27ma\u001b[27mt\u001b[27ma\u001b[27m.\u001b[27mi\u001b[27mt\u001b[27me\u001b[27mm\u001b[27ms\u001b[27m(\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mn\u001b[27me\u001b[27mw\u001b[27m \u001b[27m=\u001b[27m \u001b[27mm\u001b[27mo\u001b[27mc\u001b[27mk\u001b[27m_\u001b[27mf\u001b[27me\u001b[27mt\u001b[27mc\u001b[27mh\u001b[27m_\u001b[27ms\u001b[27mt\u001b[27ma\u001b[27mt\u001b[27mu\u001b[27ms\u001b[27m(\u001b[27m)\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mo\u001b[27ml\u001b[27md\u001b[27m \u001b[27m=\u001b[27m \u001b[27mi\u001b[27mn\u001b[27mf\u001b[27mo\u001b[27m.\u001b[27mg\u001b[27me\u001b[27mt\u001b[27m(\u001b[27m\"\u001b[27ml\u001b[27ma\u001b[27ms\u001b[27mt\u001b[27m_\u001b[27ms\u001b[27mt\u001b[27ma\u001b[27mt\u001b[27mu\u001b[27ms\u001b[27m\"\u001b[27m)\u001b[2B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mi\u001b[27mf\u001b[27m \u001b[27mo\u001b[27ml\u001b[27md\u001b[27m \u001b[27m!\u001b[27m=\u001b[27m \u001b[27mn\u001b[27me\u001b[27mw\u001b[27m:\u001b[1B\r\u001b[37P\u001b[12Calerts.append((case,new))\u001b[6C\u001b[K\u001b[1B\r\u001b[37P\u001b[12Cinfo[\"last_status\"] = new\u001b[6C\u001b[K\u001b[2B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27ms\u001b[27ma\u001b[27mv\u001b[27me\u001b[27m(\u001b[27md\u001b[27ma\u001b[27mt\u001b[27ma\u001b[27m)\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mr\u001b[27me\u001b[27mt\u001b[27mu\u001b[27mr\u001b[27mn\u001b[27m \u001b[27ma\u001b[27ml\u001b[27me\u001b[27mr\u001b[27mt\u001b[27ms\u001b[1B\r\u001b[27mE"]
