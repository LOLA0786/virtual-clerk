[6.332, "o", "\u001b[7mcat << 'EOF' > app/db.py\u001b[27m\r\r\n\u001b[7mimport json\u001b[27m\u001b[K\r\r\n\u001b[7mfrom pathlib import Path\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mDATA = Path(\"data/cases.json\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mdef load():\u001b[27m\u001b[K\r\r\n\u001b[7m    if not DATA.exists():\u001b[27m\u001b[K\r\r\n\u001b[7m        return {}\u001b[27m\u001b[K\r\r\n\u001b[7m    return json.loads(DATA.read_text())\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mdef save(data):\u001b[27m\u001b[K\r\r\n\u001b[7m    DATA.write_text(json.dumps(data, indent=2))\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.378, "o", "\u001b[13A\u001b[31C\u001b[27mc\u001b[27ma\u001b[27mt\u001b[27m \u001b[27m<\u001b[27m<\u001b[27m \u001b[27m'\u001b[27mE\u001b[27mO\u001b[27mF\u001b[27m'\u001b[27m \u001b[27m>\u001b[27m \u001b[27ma\u001b[27mp\u001b[27mp\u001b[27m/\u001b[27md\u001b[27mb\u001b[27m.\u001b[27mp\u001b[27my\u001b[1B\r\u001b[27mi\u001b[27mm\u001b[27mp\u001b[27mo\u001b[27mr\u001b[27mt\u001b[27m \u001b[27mj\u001b[27ms\u001b[27mo\u001b[27mn\u001b[1B\r\u001b[27mf\u001b[27mr\u001b[27mo\u001b[27mm\u001b[27m \u001b[27mp\u001b[27ma\u001b[27mt\u001b[27mh\u001b[27ml\u001b[27mi\u001b[27mb\u001b[27m \u001b[27mi\u001b[27mm\u001b[27mp\u001b[27mo\u001b[27mr\u001b[27mt\u001b[27m \u001b[27mP\u001b[27ma\u001b[27mt\u001b[27mh\u001b[2B\r\u001b[27mD\u001b[27mA\u001b[27mT\u001b[27mA\u001b[27m \u001b[27m=\u001b[27m \u001b[27mP\u001b[27ma\u001b[27mt\u001b[27mh\u001b[27m(\u001b[27m\"\u001b[27md\u001b[27ma\u001b[27mt\u001b[27ma\u001b[27m/\u001b[27mc\u001b[27ma\u001b[27ms\u001b[27me\u001b[27ms\u001b[27m.\u001b[27mj\u001b[27ms\u001b[27mo\u001b[27mn\u001b[27m\"\u001b[27m)\u001b[2B\r\u001b[27md\u001b[27me\u001b[27mf\u001b[27m \u001b[27ml\u001b[27mo\u001b[27ma\u001b[27md\u001b[27m(\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mi\u001b[27mf\u001b[27m \u001b[27mn\u001b[27mo\u001b[27mt\u001b[27m \u001b[27mD\u001b[27mA\u001b[27mT\u001b[27mA\u001b[27m.\u001b[27me\u001b[27mx\u001b[27mi\u001b[27ms\u001b[27mt\u001b[27ms\u001b[27m(\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mr\u001b[27me\u001b[27mt\u001b[27mu\u001b[27mr\u001b[27mn\u001b[27m \u001b[27m{\u001b[27m}\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mr\u001b[27me\u001b[27mt\u001b[27mu\u001b[27mr\u001b[27mn\u001b[27m \u001b[27mj\u001b[27ms\u001b[27mo\u001b[27mn\u001b[27m.\u001b[27ml\u001b[27mo\u001b[27ma\u001b[27md\u001b[27ms\u001b"]
[0.000, "o", "[27m(\u001b[27mD\u001b[27mA\u001b[27mT\u001b[27mA\u001b[27m.\u001b[27mr\u001b[27me\u001b[27ma\u001b[27md\u001b[27m_\u001b[27mt\u001b[27me\u001b[27mx\u001b[27mt\u001b[27m(\u001b[27m)\u001b[27m)\u001b[2B\r\u001b[27md\u001b[27me\u001b[27mf\u001b[27m \u001b[27ms\u001b[27ma\u001b[27mv\u001b[27me\u001b[27m(\u001b[27md\u001b[27ma\u001b[27mt\u001b[27ma\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mD\u001b[27mA\u001b[27mT\u001b[27mA\u001b[27m.\u001b[27mw\u001b[27mr\u001b[27mi\u001b[27mt\u001b[27me\u001b[27m_\u001b[27mt\u001b[27me\u001b[27mx\u001b[27mt\u001b[27m(\u001b[27mj\u001b[27ms\u001b[27mo\u001b[27mn\u001b[27m.\u001b[27md\u001b[27mu\u001b[27mm\u001b[27mp\u001b[27ms\u001b[27m(\u001b[27md\u001b[27ma\u001b[27mt\u001b[27ma\u001b[27m,\u001b[27m \u001b[27mi\u001b[27mn\u001b[27md\u001b[27me\u001b[27mn\u001b[27mt\u001b[27m=\u001b[27m2\u001b[27m)\u001b[27m)\u001b[1B\r\u001b[27mE\u001b[27mO\u001b[27mF"]
