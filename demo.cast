[13.549, "o", ">....                                         \r\n\u001b[7m        \"state_code\": \"27\",\u001b[27m\u001b[K\r\r\n\u001b[7m        \"dist_code\": \"1\",\u001b[27m\u001b[K\r\r\n\u001b[7m        \"court_code\": \"1\",\u001b[27m\u001b[K\r\r\n\u001b[7m        \"case_type\": case_type,\u001b[27m\u001b[K\r\r\n\u001b[7m        \"case_no\": case_no,\u001b[27m\u001b[K\r\r\n\u001b[7m        \"case_year\": year,\u001b[27m\u001b[K\r\r\n\u001b[7m    }\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    r = session.get(url, params=params, timeout=20)\u001b[27m\u001b[K\r\r\n\u001b[7m    soup = BeautifulSoup(r.text, \"lxml\")\u001b[27m\u001b[K\r\r\n\u001b[7m    text = soup.get_text(\" \", strip=True)\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    # extract next hearing date\u001b[27m\u001b[K\r\r\n\u001b[7m    date_match = re.search(r\"\\d{2}-\\d{2}-\\d{4}\", text)\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    return {\u001b[27m\u001b[K\r\r\n\u001b[7m        \"next_date\": date_match.group(0) if date_match else \"Not found\",\u001b[27m\u001b[K\r\r\n\u001b[7m        \"raw\": text[:500]\u001b[27m\u001b[K\r\r\n\u001b[7m    }\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mif __name__ == \"__main__\":\u001b[27m\u001b[K\r\r\n\u001b[7m    print(fetch_bombay_case(\"WP\",\"1234\",\"2024\"))\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
