[180.058, "o", ">....                                         \r\n\u001b[7m    with pdfplumber.open(file) as pdf:\u001b[27m\u001b[K\r\r\n\u001b[7m        text = pdf.pages[0].extract_text()\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    lines = text.split(\"\\n\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    info = {\u001b[27m\u001b[K\r\r\n\u001b[7m        \"court\": \"\",\u001b[27m\u001b[K\r\r\n\u001b[7m        \"bench\": [],\u001b[27m\u001b[K\r\r\n\u001b[7m        \"time\": \"\"\u001b[27m\u001b[K\r\r\n\u001b[7m    }\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    for line in lines:\u001b[27m\u001b[K\r\r\n\u001b[7m        if \"COURT NO.\" in line:\u001b[27m\u001b[K\r\r\n\u001b[7m            info[\"court\"] = line.strip()\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m        if \"HON'BLE\" in line:\u001b[27m\u001b[K\r\r\n\u001b[7m            info[\"bench\"].append(line.strip())\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m        if \"AM\" in line and \":\" in line:\u001b[27m\u001b[K\r\r\n\u001b[7m            info[\"time\"] = line.strip()\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    return info\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.403, "o", "\u001b[22A\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mw\u001b[27mi\u001b[27mt\u001b[27mh\u001b[27m \u001b[27mp\u001b[27md\u001b[27mf\u001b[27mp\u001b[27ml\u001b[27mu\u001b[27mm\u001b[27mb\u001b[27me\u001b[27mr\u001b[27m.\u001b[27mo\u001b[27mp\u001b[27me\u001b[27mn\u001b[27m(\u001b[27mf\u001b[27mi\u001b[27ml\u001b[27me\u001b[27m)\u001b[27m \u001b[27ma\u001b[27ms\u001b[27m \u001b[27mp\u001b[27md\u001b[27mf\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mt\u001b[27me\u001b[27mx\u001b[27mt\u001b[27m \u001b[27m=\u001b[27m \u001b[27mp\u001b[27md\u001b[27mf\u001b[27m.\u001b[27mp\u001b[27ma\u001b[27mg\u001b[27me\u001b[27ms\u001b[27m[\u001b[27m0\u001b[27m]\u001b[27m.\u001b[27me\u001b[27mx\u001b[27mt\u001b[27mr\u001b[27ma\u001b[27mc\u001b[27mt\u001b[27m_\u001b[27mt\u001b[27me\u001b[27mx\u001b[27mt\u001b[27m(\u001b[27m)\u001b[2B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27ml\u001b[27mi\u001b[27mn\u001b[27me\u001b[27ms\u001b[27m \u001b[27m=\u001b[27m \u001b[27mt\u001b[27me\u001b[27mx\u001b[27mt\u001b[27m.\u001b[27ms\u001b[27mp\u001b[27ml\u001b[27mi\u001b[27mt\u001b[27m(\u001b[27m\"\u001b[27m\\\u001b[27mn\u001b[27m\"\u001b[27m)\u001b[2B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mi\u001b[27mn\u001b[27mf\u001b[27mo\u001b[27m \u001b[27m=\u001b[27m \u001b[27m{\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m\"\u001b[27mc\u001b[27mo\u001b[27mu\u001b[27mr\u001b[27mt\u001b[27m\"\u001b[27m:\u001b[27m \u001b[27m\"\u001b[27m\"\u001b[27m,\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m\"\u001b[27mb\u001b[27me\u001b[27mn\u001b[27mc\u001b[27mh\u001b[27m\"\u001b[27m:\u001b[27m \u001b[27m[\u001b[27m]\u001b[27m,\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27"]
