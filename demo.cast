[3.470, "o", ">....                                         \r\n\u001b[K\r\r\n\u001b[7m    params = {\u001b[27m\u001b[K\r\r\n\u001b[7m        \"state_code\": \"27\",   # Maharashtra\u001b[27m\u001b[K\r\r\n\u001b[7m        \"dist_code\": \"1\",\u001b[27m\u001b[K\r\r\n\u001b[7m        \"court_code\": \"1\",\u001b[27m\u001b[K\r\r\n\u001b[7m        \"case_type\": case_type,\u001b[27m\u001b[K\r\r\n\u001b[7m        \"case_no\": case_no,\u001b[27m\u001b[K\r\r\n\u001b[7m        \"case_year\": year,\u001b[27m\u001b[K\r\r\n\u001b[7m    }\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    r = session.get(url, params=params, timeout=20)\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    soup = BeautifulSoup(r.text, \"lxml\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    text = soup.get_text(\" \", strip=True)\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    return text\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mif __name__ == \"__main__\":\u001b[27m\u001b[K\r\r\n\u001b[7m    data = fetch_bombay_case(\"WP\", \"1234\", \"2024\")\u001b[27m\u001b[K\r\r\n\u001b[7m    print(data[:1000])\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.383, "o", "\u001b[21A\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mp\u001b[27ma\u001b[27mr\u001b[27ma\u001b[27mm\u001b[27ms\u001b[27m \u001b[27m=\u001b[27m \u001b[27m{\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m\"\u001b[27ms\u001b[27mt\u001b[27ma\u001b[27mt\u001b[27me\u001b[27m_\u001b[27mc\u001b[27mo\u001b[27md\u001b[27me\u001b[27m\"\u001b[27m:\u001b[27m \u001b[27m\"\u001b[27m2\u001b[27m7\u001b[27m\"\u001b[27m,\u001b[27m \u001b[27m \u001b[27m \u001b[27m#\u001b[27m \u001b[27mM\u001b[27ma\u001b[27mh\u001b[27ma\u001b[27mr\u001b[27ma\u001b[27ms\u001b[27mh\u001b[27mt\u001b[27mr\u001b[27ma\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m\"\u001b[27md\u001b[27mi\u001b[27ms\u001b[27mt\u001b[27m_\u001b[27mc\u001b[27mo\u001b[27md\u001b[27me\u001b[27m\"\u001b[27m:\u001b[27m \u001b[27m\"\u001b[27m1\u001b[27m\"\u001b[27m,\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m\"\u001b[27mc\u001b[27mo\u001b[27mu\u001b[27mr\u001b[27mt\u001b[27m_\u001b[27mc\u001b[27mo\u001b[27md\u001b[27me\u001b[27m\"\u001b[27m:\u001b[27m \u001b[27m\"\u001b[27m1\u001b[27m\"\u001b[27m,\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m\"\u001b[27mc\u001b[27ma\u001b[27ms\u001b[27me\u001b[27m_\u001b[27mt\u001b[27my\u001b[27mp\u001b[27me\u001b[27m\"\u001b[27m:\u001b[27m \u001b[27mc\u001b[27ma\u001b[27ms\u001b[27me\u001b[27m_\u001b[27mt\u001b[27my\u001b[27mp\u001b[27me\u001b[27m,\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m\"\u001b[27mc\u001b[27ma\u001b[27ms\u001b[27me\u001b[27m_\u001b[27mn\u001b[27mo\u001b[27m\"\u001b[27m:\u001b[27m \u001b[27mc\u001b[27ma\u001b[27ms\u001b[27me\u001b[27m_\u001b[27mn\u001b[27mo\u001b[2"]
[0.000, "o", "7m,\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m\"\u001b[27mc\u001b[27ma\u001b[27ms\u001b[27me\u001b[27m_\u001b[27my\u001b[27me\u001b[27ma\u001b[27mr\u001b[27m\"\u001b[27m:\u001b[27m \u001b[27my\u001b[27me\u001b[27ma\u001b[27mr\u001b[27m,\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m}\u001b[2B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mr\u001b[27m \u001b[27m=\u001b[27m \u001b[27ms\u001b[27me\u001b[27ms\u001b[27ms\u001b[27mi\u001b[27mo\u001b[27mn\u001b[27m.\u001b[27mg\u001b[27me\u001b[27mt\u001b[27m(\u001b[27mu\u001b[27mr\u001b[27ml\u001b[27m,\u001b[27m \u001b[27mp\u001b[27ma\u001b[27mr\u001b[27ma\u001b[27mm\u001b[27ms\u001b[27m=\u001b[27mp\u001b[27ma\u001b[27mr\u001b[27ma\u001b[27mm\u001b[27ms\u001b[27m,\u001b[27m \u001b[27mt\u001b[27mi\u001b[27mm\u001b[27me\u001b[27mo\u001b[27mu\u001b[27mt\u001b[27m=\u001b[27m2\u001b[27m0\u001b[27m)\u001b[2B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27ms\u001b[27mo\u001b[27mu\u001b[27mp\u001b[27m \u001b[27m=\u001b[27m \u001b[27mB\u001b[27me\u001b[27ma\u001b[27mu\u001b[27mt\u001b[27mi\u001b[27mf\u001b[27mu\u001b[27ml\u001b[27mS\u001b[27mo\u001b[27mu\u001b[27mp\u001b[27m(\u001b[27mr\u001b[27m.\u001b[27mt\u001b[27me\u001b[27mx\u001b[27mt\u001b[27m,\u001b[27m \u001b[27m\"\u001b[27ml\u001b[27mx\u001b[27mm\u001b[27ml\u001b[27m\"\u001b[27m)\u001b[2B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mt\u001b[27me\u001b[27mx\u001b[27mt\u001b[27m \u001b[27m=\u001b[27m \u001b[27ms\u001b[27mo\u001b[27mu\u001b[27mp\u001b[27m.\u001b[27mg\u001b[27me\u001b[27mt\u001b[27m_\u001b[27mt\u001b[27me\u001b[27mx\u001b[27mt\u001b[27m(\u001b[27m\"\u001b[27m \u001b[27m\"\u001b[27m,\u001b[27m \u001b[27ms\u001b[27mt\u001b[27mr\u001b[27mi\u001b[27mp\u001b[27m=\u001b[27mT\u001b[27mr\u001b[27mu\u001b[27me\u001b[27m)\u001b[2B\r\u001b[27m \u001b[27m \u001b"]
