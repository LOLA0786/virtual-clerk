[7.078, "o", ">....                                         \r\n\u001b[7m    else:\u001b[27m\u001b[K\r\r\n\u001b[7m        print(\"\\n✅ Listed in:\")\u001b[27m\u001b[K\r\r\n\u001b[7m        for f in found:\u001b[27m\u001b[K\r\r\n\u001b[7m            print(\"•\", f)\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m@app.command()\u001b[27m\u001b[K\r\r\n\u001b[7mdef orders():\u001b[27m\u001b[K\r\r\n\u001b[7m    files = list_orders()\u001b[27m\u001b[K\r\r\n\u001b[7m    if not files:\u001b[27m\u001b[K\r\r\n\u001b[7m        print(\"No orders uploaded\")\u001b[27m\u001b[K\r\r\n\u001b[7m        return\u001b[27m\u001b[K\r\r\n\u001b[7m    for f in files:\u001b[27m\u001b[K\r\r\n\u001b[7m        print(\"•\", f)\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m@app.command()\u001b[27m\u001b[K\r\r\n\u001b[7mdef summarize(file: str):\u001b[27m\u001b[K\r\r\n\u001b[7m    result = summarize_order(file)\u001b[27m\u001b[K\r\r\n\u001b[7m    for k,v in result.items():\u001b[27m\u001b[K\r\r\n\u001b[7m        print(f\"{k}: {v}\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mif __name__ == \"__main__\":\u001b[27m\u001b[K\r\r\n\u001b[7m    app()\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.318, "o", "\u001b[22A\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27me\u001b[27ml\u001b[27ms\u001b[27me\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mp\u001b[27mr\u001b[27mi\u001b[27mn\u001b[27mt\u001b[27m(\u001b[27m\"\u001b[27m\\\u001b[27mn\u001b[27m✅\u001b[27m\u001b[27m \u001b[27mL\u001b[27mi\u001b[27ms\u001b[27mt\u001b[27me\u001b[27md\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m:\u001b[27m\"\u001b[27m)\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mf\u001b[27mo\u001b[27mr\u001b[27m \u001b[27mf\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m \u001b[27mf\u001b[27mo\u001b[27mu\u001b[27mn\u001b[27md\u001b[27m:\u001b[1B\r\u001b[25P\u001b[12Cprint(\"•\", f)\u001b[30C\u001b[K\u001b[2B\r\u001b[27m@\u001b[27ma\u001b[27mp\u001b[27mp\u001b[27m.\u001b[27mc\u001b[27mo\u001b[27mm\u001b[27mm\u001b[27ma\u001b[27mn\u001b[27md\u001b[27m(\u001b[27m)\u001b[1B\r\u001b[27md\u001b[27me\u001b[27mf\u001b[27m \u001b[27mo\u001b[27mr\u001b[27md\u001b[27me\u001b[27mr\u001b[27ms\u001b[27m(\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mf\u001b[27mi\u001b[27ml\u001b[27me\u001b[27ms\u001b[27m \u001b[27m=\u001b[27m \u001b[27ml\u001b[27mi\u001b[27ms\u001b[27mt\u001b[27m_\u001b[27mo\u001b[27mr\u001b[27md\u001b[27me\u001b[27mr\u001b[27ms\u001b[27m(\u001b[27m)\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mi\u001b[27mf\u001b[27m \u001b[27mn\u001b[27mo\u001b[27mt\u001b[27m \u001b[27mf\u001b[27mi\u001b[27ml\u001b[27me\u001b[27ms\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mp\u001b[27mr\u001b[27mi\u001b[27mn\u001b[27mt\u001b[27m(\u001b[27m\"\u001b[27mN\u001b[27mo\u001b[27m \u001b[27mo\u001b[27mr\u001b[27md\u001b[27me\u001b[27mr\u001b[27ms\u001b["]
