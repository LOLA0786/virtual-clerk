[3.760, "o", "\u001b[7mcat << 'EOF' > app/listing.py\u001b[27m\r\r\n\u001b[7mimport pdfplumber\u001b[27m\u001b[K\r\r\n\u001b[7mfrom pathlib import Path\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mPDF_DIR = Path(\"benches\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mdef find_listing(case_number):\u001b[27m\u001b[K\r\r\n\u001b[7m    results = []\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    for pdf in PDF_DIR.glob(\"*.pdf\"):\u001b[27m\u001b[K\r\r\n\u001b[7m        try:\u001b[27m\u001b[K\r\r\n\u001b[7m            with pdfplumber.open(pdf) as doc:\u001b[27m\u001b[K\r\r\n\u001b[7m                for page in doc.pages:\u001b[27m\u001b[K\r\r\n\u001b[7m                    text = page.extract_text() or \"\"\u001b[27m\u001b[K\r\r\n\u001b[7m                    if case_number in text:\u001b[27m\u001b[K\r\r\n\u001b[7m                        results.append(pdf.name)\u001b[27m\u001b[K\r\r\n\u001b[7m        except:\u001b[27m\u001b[K\r\r\n\u001b[7m            continue\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    return results\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.328, "o", "\u001b[20A\u001b[31C\u001b[27mc\u001b[27ma\u001b[27mt\u001b[27m \u001b[27m<\u001b[27m<\u001b[27m \u001b[27m'\u001b[27mE\u001b[27mO\u001b[27mF\u001b[27m'\u001b[27m \u001b[27m>\u001b[27m \u001b[27ma\u001b[27mp\u001b[27mp\u001b[27m/\u001b[27ml\u001b[27mi\u001b[27ms\u001b[27mt\u001b[27mi\u001b[27mn\u001b[27mg\u001b[27m.\u001b[27mp\u001b[27my\u001b[1B\r\u001b[27mi\u001b[27mm\u001b[27mp\u001b[27mo\u001b[27mr\u001b[27mt\u001b[27m \u001b[27mp\u001b[27md\u001b[27mf\u001b[27mp\u001b[27ml\u001b[27mu\u001b[27mm\u001b[27mb\u001b[27me\u001b[27mr\u001b[1B\r\u001b[27mf\u001b[27mr\u001b[27mo\u001b[27mm\u001b[27m \u001b[27mp\u001b[27ma\u001b[27mt\u001b[27mh\u001b[27ml\u001b[27mi\u001b[27mb\u001b[27m \u001b[27mi\u001b[27mm\u001b[27mp\u001b[27mo\u001b[27mr\u001b[27mt\u001b[27m \u001b[27mP\u001b[27ma\u001b[27mt\u001b[27mh\u001b[2B\r\u001b[27mP\u001b[27mD\u001b[27mF\u001b[27m_\u001b[27mD\u001b[27mI\u001b[27mR\u001b[27m \u001b[27m=\u001b[27m \u001b[27mP\u001b[27ma\u001b[27mt\u001b[27mh\u001b[27m(\u001b[27m\"\u001b[27mb\u001b[27me\u001b[27mn\u001b[27mc\u001b[27mh\u001b[27me\u001b[27ms\u001b[27m\"\u001b[27m)\u001b[2B\r\u001b[27md\u001b[27me\u001b[27mf\u001b[27m \u001b[27mf\u001b[27mi\u001b[27mn\u001b[27md\u001b[27m_\u001b[27ml\u001b[27mi\u001b[27ms\u001b[27mt\u001b[27mi\u001b[27mn\u001b[27mg\u001b[27m(\u001b[27mc\u001b[27ma\u001b[27ms\u001b[27me\u001b[27m_\u001b[27mn\u001b[27mu\u001b[27mm\u001b[27mb\u001b[27me\u001b[27mr\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mr\u001b[27me\u001b[27ms\u001b[27mu\u001b[27ml\u001b[27mt\u001b[27ms\u001b[27m \u001b[27m=\u001b[27m \u001b[27m[\u001b[27m]\u001b[2B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mf\u001b[27mo\u001b[27mr\u001b[27m \u001b[27mp\u001b[27md\u001b[27mf\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m \u001b[27mP\u001b[27mD\u001b[27mF\u001b[27m_\u001b[27mD\u001b[27mI\u001b[27mR\u001b[27m."]
[0.000, "o", "\u001b[27mg\u001b[27ml\u001b[27mo\u001b[27mb\u001b[27m(\u001b[27m\"\u001b[27m*\u001b[27m.\u001b[27mp\u001b[27md\u001b[27mf\u001b[27m\"\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mt\u001b[27mr\u001b[27my\u001b[27m:\u001b[1B\r\u001b[45P\u001b[12Cwith pdfplumber.open(pdf) as doc:\u001b[K\u001b[1B\r\u001b[38P\u001b[16Cfor page in doc.pages:\u001b[4C\u001b[K\u001b[1B\r\u001b[52P\u001b[20Ctext = page.extract_text() or \"\"\u001b[K\u001b[1B\r\u001b[43P\u001b[20Cif case_number in text:\u001b[K\u001b[1B\r\u001b[48P\u001b[24Cresults.append(pdf.name)\u001b[K\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27me\u001b[27mx\u001b[27mc\u001b[27me\u001b[27mp\u001b[27mt\u001b[27m:\u001b[1B\r\u001b[20P\u001b[12Ccontinue\u001b[40C\u001b[K\u001b[2B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mr\u001b[27me\u001b[27mt\u001b[27mu\u001b[27mr\u001b[27mn\u001b[27m \u001b[27mr\u001b[27me\u001b[27ms\u001b[27mu\u001b[27ml\u001b[27mt\u001b[27ms\u001b[1B\r\u001b[27mE\u001b[27mO\u001b[27mF"]
