[58.148, "o", ">....                                         \r\n\u001b[7m    if not results:\u001b[27m\u001b[K\r\r\n\u001b[7m        print(\"❌ Not listed\")\u001b[27m\u001b[K\r\r\n\u001b[7m        return\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    for r in results:\u001b[27m\u001b[K\r\r\n\u001b[7m        print(\"[bold green]LISTED[/bold green]\\n\")\u001b[27m\u001b[K\r\r\n\u001b[7m        print(\"Court:\", r[\"bench\"][\"court\"])\u001b[27m\u001b[K\r\r\n\u001b[7m        print(\"Bench:\")\u001b[27m\u001b[K\r\r\n\u001b[7m        for j in r[\"bench\"][\"bench\"]:\u001b[27m\u001b[K\r\r\n\u001b[7m            print(\"  \", j)\u001b[27m\u001b[K\r\r\n\u001b[7m        print(\"Time:\", r[\"bench\"][\"time\"])\u001b[27m\u001b[K\r\r\n\u001b[7m        print(\"Sequence:\", r[\"sequence\"])\u001b[27m\u001b[K\r\r\n\u001b[7m        print(\"Entry:\", r[\"line\"])\u001b[27m\u001b[K\r\r\n\u001b[7m        print()\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m@app.command()\u001b[27m\u001b[K\r\r\n\u001b[7mdef version():\u001b[27m\u001b[K\r\r\n\u001b[7m    \"\"\"Show version\"\"\"\u001b[27m\u001b[K\r\r\n\u001b[7m    print(\"VC v0.1\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mif __name__ == \"__main__\":\u001b[27m\u001b[K\r\r\n\u001b[7m    app()\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.283, "o", "\u001b[22A\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mi\u001b[27mf\u001b[27m \u001b[27mn\u001b[27mo\u001b[27mt\u001b[27m \u001b[27mr\u001b[27me\u001b[27ms\u001b[27mu\u001b[27ml\u001b[27mt\u001b[27ms\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mp\u001b[27mr\u001b[27mi\u001b[27mn\u001b[27mt\u001b[27m(\u001b[27m\"\u001b[27m❌\u001b[27m\u001b[27m \u001b[27mN\u001b[27mo\u001b[27mt\u001b[27m \u001b[27ml\u001b[27mi\u001b[27ms\u001b[27mt\u001b[27me\u001b[27md\u001b[27m\"\u001b[27m)\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mr\u001b[27me\u001b[27mt\u001b[27mu\u001b[27mr\u001b[27mn\u001b[2B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mf\u001b[27mo\u001b[27mr\u001b[27m \u001b[27mr\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m \u001b[27mr\u001b[27me\u001b[27ms\u001b[27mu\u001b[27ml\u001b[27mt\u001b[27ms\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mp\u001b[27mr\u001b[27mi\u001b[27mn\u001b[27mt\u001b[27m(\u001b[27m\"\u001b[27m[\u001b[27mb\u001b[27mo\u001b[27ml\u001b[27md\u001b[27m \u001b[27mg\u001b[27mr\u001b[27me\u001b[27me\u001b[27mn\u001b[27m]\u001b[27mL\u001b[27mI\u001b[27mS\u001b[27mT\u001b[27mE\u001b[27mD\u001b[27m[\u001b[27m/\u001b[27mb\u001b[27mo\u001b[27ml\u001b[27md\u001b[27m \u001b[27mg\u001b[27mr\u001b[27me\u001b[27me\u001b[27mn\u001b[27m]\u001b[27m\\\u001b[27mn\u001b[27m\"\u001b[27m)\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mp\u001b[27mr\u001b[27mi\u001b[27mn\u001b[27mt\u001b[27m(\u001b[27m\"\u001b[27mC\u001b[27mo\u001b[27mu\u001b[27mr\u001b[27mt\u001b[27m:\u001b[27m\"\u001b[27m,\u001b[27m \u001b[27mr\u001b[27m[\u001b[27m\"\u001b[27mb\u001b[27me\u001b[27mn\u001b[27mc\u001b["]
