[48.351, "o", "\u001b[7mcat << 'EOF' > app/sequence_extract.py\u001b[27m\r\r\n\u001b[7mimport pdfplumber\u001b[27m\u001b[K\r\r\n\u001b[7mimport re\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mdef find_sequence(file, case_number):\u001b[27m\u001b[K\r\r\n\u001b[7m    with pdfplumber.open(file) as pdf:\u001b[27m\u001b[K\r\r\n\u001b[7m        for page in pdf.pages:\u001b[27m\u001b[K\r\r\n\u001b[7m            text = page.extract_text() or \"\"\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m            for line in text.split(\"\\n\"):\u001b[27m\u001b[K\r\r\n\u001b[7m                if case_number in line:\u001b[27m\u001b[K\r\r\n\u001b[7m                    match = re.match(r'\\s*(\\d+)', line)\u001b[27m\u001b[K\r\r\n\u001b[7m                    if match:\u001b[27m\u001b[K\r\r\n\u001b[7m                        return {\u001b[27m\u001b[K\r\r\n\u001b[7m                            \"sequence\": match.group(1),\u001b[27m\u001b[K\r\r\n\u001b[7m                            \"line\": line.strip()\u001b[27m\u001b[K\r\r\n\u001b[7m                        }\u001b[27m\u001b[K\r\r\n\u001b[7m    return None\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.402, "o", "\u001b[18A\u001b[31C\u001b[27mc\u001b[27ma\u001b[27mt\u001b[27m \u001b[27m<\u001b[27m<\u001b[27m \u001b[27m'\u001b[27mE\u001b[27mO\u001b[27mF\u001b[27m'\u001b[27m \u001b[27m>\u001b[27m \u001b[27ma\u001b[27mp\u001b[27mp\u001b[27m/\u001b[27ms\u001b[27me\u001b[27mq\u001b[27mu\u001b[27me\u001b[27mn\u001b[27mc\u001b[27me\u001b[27m_\u001b[27me\u001b[27mx\u001b[27mt\u001b[27mr\u001b[27ma\u001b[27mc\u001b[27mt\u001b[27m.\u001b[27mp\u001b[27my\u001b[1B\r\u001b[27mi\u001b[27mm\u001b[27mp\u001b[27mo\u001b[27mr\u001b[27mt\u001b[27m \u001b[27mp\u001b[27md\u001b[27mf\u001b[27mp\u001b[27ml\u001b[27mu\u001b[27mm\u001b[27mb\u001b[27me\u001b[27mr\u001b[1B\r\u001b[27mi\u001b[27mm\u001b[27mp\u001b[27mo\u001b[27mr\u001b[27mt\u001b[27m \u001b[27mr\u001b[27me\u001b[2B\r\u001b[27md\u001b[27me\u001b[27mf\u001b[27m \u001b[27mf\u001b[27mi\u001b[27mn\u001b[27md\u001b[27m_\u001b[27ms\u001b[27me\u001b[27mq\u001b[27mu\u001b[27me\u001b[27mn\u001b[27mc\u001b[27me\u001b[27m(\u001b[27mf\u001b[27mi\u001b[27ml\u001b[27me\u001b[27m,\u001b[27m \u001b[27mc\u001b[27ma\u001b[27ms\u001b[27me\u001b[27m_\u001b[27mn\u001b[27mu\u001b[27mm\u001b[27mb\u001b[27me\u001b[27mr\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mw\u001b[27mi\u001b[27mt\u001b[27mh\u001b[27m \u001b[27mp\u001b[27md\u001b[27mf\u001b[27mp\u001b[27ml\u001b[27mu\u001b[27mm\u001b[27mb\u001b[27me\u001b[27mr\u001b[27m.\u001b[27mo\u001b[27mp\u001b[27me\u001b[27mn\u001b[27m(\u001b[27mf\u001b[27mi\u001b[27ml\u001b[27me\u001b[27m)\u001b[27m \u001b[27ma\u001b[27ms\u001b[27m \u001b[27mp\u001b[27md\u001b[27mf\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mf\u001b[27mo\u001b[27mr\u001b[27m \u001b[27mp\u001b[27ma\u001b[27mg\u001b[27me\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m \u001b[27mp\u001b[27md\u001b[27mf\u001b[27m.\u001b[27mp\u001b[27m"]
[0.001, "o", "a\u001b[27mg\u001b[27me\u001b[27ms\u001b[27m:\u001b[1B\r\u001b[44P\u001b[12Ctext = page.extract_text() or \"\"\u001b[K\u001b[2B\r\u001b[41P\u001b[12Cfor line in text.split(\"\\n\"):\u001b[K\u001b[1B\r\u001b[39P\u001b[16Cif case_number in line:\u001b[2C\u001b[K\u001b[1B\r\u001b[55P\u001b[20Cmatch = re.match(r'\\s*(\\d+)', line)\u001b[K\u001b[1B\r\u001b[29P\u001b[20Cif match:\u001b[22C\u001b[K\u001b[1B\r\u001b[32P\u001b[24Creturn {\u001b[16C\u001b[K\u001b[1B\r\u001b[55P\u001b[25C   \"sequence\": match.group(1),\u001b[K\u001b[1B\r\u001b[48P\u001b[28C\"line\": line.strip()\u001b[K\u001b[1B\r\u001b[25P\u001b[24C}\u001b[30C\u001b[K\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mr\u001b[27me\u001b[27mt\u001b[27mu\u001b[27mr\u001b[27mn\u001b[27m \u001b[27mN\u001b[27mo\u001b[27mn\u001b[27me\u001b[1B\r\u001b[27mE\u001b[27mO\u001b[27mF\u001b[?2004l\r\r\n"]
