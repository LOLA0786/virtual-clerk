[0.510, "o", "\u001b[A\u001b[A\u001b[7C\u001b[27mm\u001b[27mk\u001b[27md\u001b[27mi\u001b[27mr\u001b[27m \u001b[27m-\u001b[27mp\u001b[27m \u001b[27ma\u001b[27mp\u001b[27mp\u001b[27m \u001b[27md\u001b[27ma\u001b[27mt\u001b[27ma\u001b[27m \u001b[27mo\u001b[27mr\u001b[27md\u001b[27me\u001b[27mr\u001b[27ms\u001b[1B\r\u001b[27mt\u001b[27mo\u001b[27mu\u001b[27mc\u001b[27mh\u001b[27m \u001b[27md\u001b[27ma\u001b[27mt\u001b[27ma\u001b[27m/\u001b[27mc\u001b[27ma\u001b[27ms\u001b[27me\u001b[27ms\u001b[27m.\u001b[27mj\u001b[27ms\u001b[27mo\u001b[27mn\u001b[1B\r\u001b[27me\u001b[27mc\u001b[27mh\u001b[27mo\u001b[27m \u001b[27m\"\u001b[27m{\u001b[27m}\u001b[27m\"\u001b[27m \u001b[27m>\u001b[27m \u001b[27md\u001b[27ma\u001b[27mt\u001b[27ma\u001b[27m/\u001b[27mc\u001b[27ma\u001b[27ms\u001b[27me\u001b[27ms\u001b[27m.\u001b[27mj\u001b[27ms\u001b[27mo\u001b[27mn"]
