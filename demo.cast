[22.442, "o", "\u001b[7mcat << 'EOF' >> README.md\u001b[27m\r\r\n\u001b[K\r\r\n\u001b[7m## Features\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m- Court listing detection\u001b[27m\u001b[K\r\r\n\u001b[7m- Bench & courtroom intelligence\u001b[27m\u001b[K\r\r\n\u001b[7m- Sequence position detection\u001b[27m\u001b[K\r\r\n\u001b[7m- Order document parsing\u001b[27m\u001b[K\r\r\n\u001b[7m- CLI workflow for litigation tracking\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
