[4.494, "o", ">....                                         \r\n\u001b[7m    print(f\"[green]Added {case_no}[/green]\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m@app.command()\u001b[27m\u001b[K\r\r\n\u001b[7mdef list():\u001b[27m\u001b[K\r\r\n\u001b[7m    for c in list_cases():\u001b[27m\u001b[K\r\r\n\u001b[7m        print(c)\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m@app.command()\u001b[27m\u001b[K\r\r\n\u001b[7mdef check():\u001b[27m\u001b[K\r\r\n\u001b[7m    alerts = check_updates()\u001b[27m\u001b[K\r\r\n\u001b[7m    if not alerts:\u001b[27m\u001b[K\r\r\n\u001b[7m        print(\"[yellow]No changes[/yellow]\")\u001b[27m\u001b[K\r\r\n\u001b[7m        return\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    print(\"\\n[bold]Updates:[/bold]\\n\")\u001b[27m\u001b[K\r\r\n\u001b[7m    for case, status in alerts:\u001b[27m\u001b[K\r\r\n\u001b[7m        print(f\"[cyan]{case}[/cyan]\")\u001b[27m\u001b[K\r\r\n\u001b[7m        for k,v in status.items():\u001b[27m\u001b[K\r\r\n\u001b[7m            print(f\"  {k}: {v}\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mif __name__ == \"__main__\":\u001b[27m\u001b[K\r\r\n\u001b[7m    app()\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.360, "o", "\u001b[22A\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mp\u001b[27mr\u001b[27mi\u001b[27mn\u001b[27mt\u001b[27m(\u001b[27mf\u001b[27m\"\u001b[27m[\u001b[27mg\u001b[27mr\u001b[27me\u001b[27me\u001b[27mn\u001b[27m]\u001b[27mA\u001b[27md\u001b[27md\u001b[27me\u001b[27md\u001b[27m \u001b[27m{\u001b[27mc\u001b[27ma\u001b[27ms\u001b[27me\u001b[27m_\u001b[27mn\u001b[27mo\u001b[27m}\u001b[27m[\u001b[27m/\u001b[27mg\u001b[27mr\u001b[27me\u001b[27me\u001b[27mn\u001b[27m]\u001b[27m\"\u001b[27m)\u001b[2B\r\u001b[27m@\u001b[27ma\u001b[27mp\u001b[27mp\u001b[27m.\u001b[27mc\u001b[27mo\u001b[27mm\u001b[27mm\u001b[27ma\u001b[27mn\u001b[27md\u001b[27m(\u001b[27m)\u001b[1B\r\u001b[27md\u001b[27me\u001b[27mf\u001b[27m \u001b[27ml\u001b[27mi\u001b[27ms\u001b[27mt\u001b[27m(\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mf\u001b[27mo\u001b[27mr\u001b[27m \u001b[27mc\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m \u001b[27ml\u001b[27mi\u001b[27ms\u001b[27mt\u001b[27m_\u001b[27mc\u001b[27ma\u001b[27ms\u001b[27me\u001b[27ms\u001b[27m(\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mp\u001b[27mr\u001b[27mi\u001b[27mn\u001b[27mt\u001b[27m(\u001b[27mc\u001b[27m)\u001b[2B\r\u001b[27m@\u001b[27ma\u001b[27mp\u001b[27mp\u001b[27m.\u001b[27mc\u001b[27mo\u001b[27mm\u001b[27mm\u001b[27ma\u001b[27mn\u001b[27md\u001b[27m(\u001b[27m)\u001b[1B\r\u001b[27md\u001b[27me\u001b[27mf\u001b[27m \u001b[27mc\u001b[27mh\u001b[27me\u001b[27mc\u001b[27mk\u001b[27m(\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27ma\u001b[27ml\u001b[27me\u001b[27mr\u001b[27mt\u001b[27ms\u001b[27m \u001b[27m=\u001b[27m \u001b[27mc\u001b[27mh\u001b[27me\u001b[27mc\u001b[27mk\u001b[27m_\u001b[27mu\u001b[27mp\u001b[27md\u001b[27ma\u001b[27mt\u001b[27me\u001b[27ms\u001b[27m"]
[0.000, "o", "(\u001b[27m)\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mi\u001b[27mf\u001b[27m \u001b[27mn\u001b[27mo\u001b[27mt\u001b[27m \u001b[27ma\u001b[27ml\u001b[27me\u001b[27mr\u001b[27mt\u001b[27ms\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mp\u001b[27mr\u001b[27mi\u001b[27mn\u001b[27mt\u001b[27m(\u001b[27m\"\u001b[27m[\u001b[27my\u001b[27me\u001b[27ml\u001b[27ml\u001b[27mo\u001b[27mw\u001b[27m]\u001b[27mN\u001b[27mo\u001b[27m \u001b[27mc\u001b[27mh\u001b[27ma\u001b[27mn\u001b[27mg\u001b[27me\u001b[27ms\u001b[27m[\u001b[27m/\u001b[27my\u001b[27me\u001b[27ml\u001b[27ml\u001b[27mo\u001b[27mw\u001b[27m]\u001b[27m\"\u001b[27m)\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mr\u001b[27me\u001b[27mt\u001b[27mu\u001b[27mr\u001b[27mn\u001b[2B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mp\u001b[27mr\u001b[27mi\u001b[27mn\u001b[27mt\u001b[27m(\u001b[27m\"\u001b[27m\\\u001b[27mn\u001b[27m[\u001b[27mb\u001b[27mo\u001b[27ml\u001b[27md\u001b[27m]\u001b[27mU\u001b[27mp\u001b[27md\u001b[27ma\u001b[27mt\u001b[27me\u001b[27ms\u001b[27m:\u001b[27m[\u001b[27m/\u001b[27mb\u001b[27mo\u001b[27ml\u001b[27md\u001b[27m]\u001b[27m\\\u001b[27mn\u001b[27m\"\u001b[27m)\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mf\u001b[27mo\u001b[27mr\u001b[27m \u001b[27mc\u001b[27ma\u001b[27ms\u001b[27me\u001b[27m,\u001b[27m \u001b[27ms\u001b[27mt\u001b[27ma\u001b[27mt\u001b[27mu\u001b[27ms\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m \u001b[27ma\u001b[27ml\u001b[27me\u001b[27mr\u001b[27mt\u001b[27ms\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mp\u001b[27mr\u001b[27mi\u001b[27mn\u001b[27mt\u001b[27m(\u001b[27mf\u001b[27m\"\u001b[27m[\u001b[27mc\u001b[27my\u001b[2"]
