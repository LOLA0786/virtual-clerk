[1.303, "o", "\u001b[7mcat << 'EOF' > app/whatsapp.py\u001b[27m\r\r\n\u001b[7mfrom twilio.rest import Client\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mACCOUNT_SID = \"PASTE_ACCOUNT_SID\"\u001b[27m\u001b[K\r\r\n\u001b[7mAUTH_TOKEN = \"PASTE_AUTH_TOKEN\"\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mFROM = \"whatsapp:+14155238886\"   # Twilio sandbox\u001b[27m\u001b[K\r\r\n\u001b[7mTO = \"whatsapp:+91XXXXXXXXXX\"    # your phone number\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mclient = Client(ACCOUNT_SID, AUTH_TOKEN)\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mdef send_message(text):\u001b[27m\u001b[K\r\r\n\u001b[7m    client.messages.create(\u001b[27m\u001b[K\r\r\n\u001b[7m        from_=FROM,\u001b[27m\u001b[K\r\r\n\u001b[7m        to=TO,\u001b[27m\u001b[K\r\r\n\u001b[7m        body=text\u001b[27m\u001b[K\r\r\n\u001b[7m    )\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.597, "o", "\u001b[17A\u001b[31C\u001b[27mc\u001b[27ma\u001b[27mt\u001b[27m \u001b[27m<\u001b[27m<\u001b[27m \u001b[27m'\u001b[27mE\u001b[27mO\u001b[27mF\u001b[27m'\u001b[27m \u001b[27m>\u001b[27m \u001b[27ma\u001b[27mp\u001b[27mp\u001b[27m/\u001b[27mw\u001b[27mh\u001b[27ma\u001b[27mt\u001b[27ms\u001b[27ma\u001b[27mp\u001b[27mp\u001b[27m.\u001b[27mp\u001b[27my\u001b[1B\r\u001b[27mf\u001b[27mr\u001b[27mo\u001b[27mm\u001b[27m \u001b[27mt\u001b[27mw\u001b[27mi\u001b[27ml\u001b[27mi\u001b[27mo\u001b[27m.\u001b[27mr\u001b[27me\u001b[27ms\u001b[27mt\u001b[27m \u001b[27mi\u001b[27mm\u001b[27mp\u001b[27mo\u001b[27mr\u001b[27mt\u001b[27m \u001b[27mC\u001b[27ml\u001b[27mi\u001b[27me\u001b[27mn\u001b[27mt\u001b[2B\r\u001b[27mA\u001b[27mC\u001b[27mC\u001b[27mO\u001b[27mU\u001b[27mN\u001b[27mT\u001b[27m_\u001b[27mS\u001b[27mI\u001b[27mD\u001b[27m \u001b[27m=\u001b[27m \u001b[27m\"\u001b[27mP\u001b[27mA\u001b[27mS\u001b[27mT\u001b[27mE\u001b[27m_\u001b[27mA\u001b[27mC\u001b[27mC\u001b[27mO\u001b[27mU\u001b[27mN\u001b[27mT\u001b[27m_\u001b[27mS\u001b[27mI\u001b[27mD\u001b[27m\"\u001b[1B\r\u001b[27mA\u001b[27mU\u001b[27mT\u001b[27mH\u001b[27m_\u001b[27mT\u001b[27mO\u001b[27mK\u001b[27mE\u001b[27mN\u001b[27m \u001b[27m=\u001b[27m \u001b[27m\"\u001b[27mP\u001b[27mA\u001b[27mS\u001b[27mT\u001b[27mE\u001b[27m_\u001b[27mA\u001b[27mU\u001b[27mT\u001b[27mH\u001b[27m_\u001b[27mT\u001b[27mO\u001b[27mK\u001b[27mE\u001b[27mN\u001b[27m\"\u001b[2B\r\u001b[27mF\u001b[27mR\u001b[27mO\u001b[27mM\u001b[27m \u001b[27m=\u001b[27m \u001b[27m\"\u001b[27mw\u001b[27mh\u001b[27ma\u001b[27mt\u001b[27ms\u001b[27ma\u001b[27mp\u001b[27mp\u001b[27m:\u001b[27m+\u001b[27m1\u001b[27m4\u001b[27m1\u001b[27m5\u001b[27m5\u001b[27m2\u001b[27m3\u001b[27m8\u001b[27m8\u001b[27m8\u001b[27m6\u001b[27m\"\u001b[27m \u001b[27m \u001b[27m \u001b[27m#\u001b[27m \u001b[27mT\u001b[27mw\u001b[27mi\u001b[27ml\u001b[27mi\u001b[27mo\u001b[27"]
