[5.962, "o", "\u001b[7mpython - << 'EOF'\u001b[27m\r\r\n\u001b[7mfrom app.sequence_extract import find_sequence\u001b[27m\u001b[K\r\r\n\u001b[7mfrom pathlib import Path\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mfor pdf in Path(\"benches\").glob(\"*.pdf\"):\u001b[27m\u001b[K\r\r\n\u001b[7m    res = find_sequence(pdf, \"12305\")\u001b[27m\u001b[K\r\r\n\u001b[7m    if res:\u001b[27m\u001b[K\r\r\n\u001b[7m        print(pdf, res)\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.310, "o", "\u001b[8A\u001b[31C\u001b[27mp\u001b[27my\u001b[27mt\u001b[27mh\u001b[27mo\u001b[27mn\u001b[27m \u001b[27m-\u001b[27m \u001b[27m<\u001b[27m<\u001b[27m \u001b[27m'\u001b[27mE\u001b[27mO\u001b[27mF\u001b[27m'\u001b[1B\r\u001b[27mf\u001b[27mr\u001b[27mo\u001b[27mm\u001b[27m \u001b[27ma\u001b[27mp\u001b[27mp\u001b[27m.\u001b[27ms\u001b[27me\u001b[27mq\u001b[27mu\u001b[27me\u001b[27mn\u001b[27mc\u001b[27me\u001b[27m_\u001b[27me\u001b[27mx\u001b[27mt\u001b[27mr\u001b[27ma\u001b[27mc\u001b[27mt\u001b[27m \u001b[27mi\u001b[27mm\u001b[27mp\u001b[27mo\u001b[27mr\u001b[27mt\u001b[27m \u001b[27mf\u001b[27mi\u001b[27mn\u001b[27md\u001b[27m_\u001b[27ms\u001b[27me\u001b[27mq\u001b[27mu\u001b[27me\u001b[27mn\u001b[27mc\u001b[27me\u001b[1B\r\u001b[27mf\u001b[27mr\u001b[27mo\u001b[27mm\u001b[27m \u001b[27mp\u001b[27ma\u001b[27mt\u001b[27mh\u001b[27ml\u001b[27mi\u001b[27mb\u001b[27m \u001b[27mi\u001b[27mm\u001b[27mp\u001b[27mo\u001b[27mr\u001b[27mt\u001b[27m \u001b[27mP\u001b[27ma\u001b[27mt\u001b[27mh\u001b[2B\r\u001b[27mf\u001b[27mo\u001b[27mr\u001b[27m \u001b[27mp\u001b[27md\u001b[27mf\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m \u001b[27mP\u001b[27ma\u001b[27mt\u001b[27mh\u001b[27m(\u001b[27m\"\u001b[27mb\u001b[27me\u001b[27mn\u001b[27mc\u001b[27mh\u001b[27me\u001b[27ms\u001b[27m\"\u001b[27m)\u001b[27m.\u001b[27mg\u001b[27ml\u001b[27mo\u001b[27mb\u001b[27m(\u001b[27m\"\u001b[27m*\u001b[27m.\u001b[27mp\u001b[27md\u001b[27mf\u001b[27m\"\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mr\u001b[27me\u001b[27ms\u001b[27m \u001b[27m=\u001b[27m \u001b[27mf\u001b[27mi\u001b[27mn\u001b[27md\u001b[27m_\u001b[27ms\u001b[27me\u001b[27mq\u001b[27mu\u001b[27me\u001b[27mn\u001b[27mc\u001b[27me\u001b[27m(\u001b[27mp\u001b[27md\u001b[27mf\u001b[27m,\u001b[27m \u001b[27m\"\u001b[27m1\u001b[27m2\u001b[27m3\u001b[27m0\u001b[27m5\u001b[27m\"\u001b[27m)\u001b[1B\r"]
