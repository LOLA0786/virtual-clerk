[14.766, "o", ">....                                         \r\n\u001b[7m    url = BASE + \"causelist\"\u001b[27m\u001b[K\r\r\n\u001b[7m    r = requests.get(url, timeout=30)\u001b[27m\u001b[K\r\r\n\u001b[7m    soup = BeautifulSoup(r.text, \"html.parser\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    links = []\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    for a in soup.find_all(\"a\", href=True):\u001b[27m\u001b[K\r\r\n\u001b[7m        href = a[\"href\"]\u001b[27m\u001b[K\r\r\n\u001b[7m        if \".pdf\" in href.lower():\u001b[27m\u001b[K\r\r\n\u001b[7m            links.append(BASE + href)\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    for link in links:\u001b[27m\u001b[K\r\r\n\u001b[7m        name = link.split(\"/\")[-1]\u001b[27m\u001b[K\r\r\n\u001b[7m        path = SAVE / name\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m        try:\u001b[27m\u001b[K\r\r\n\u001b[7m            res = requests.get(link, timeout=30)\u001b[27m\u001b[K\r\r\n\u001b[7m            if \"application/pdf\" in res.headers.get(\"content-type\",\"\"):\u001b[27m\u001b[K\r\r\n\u001b[7m                path.write_bytes(res.content)\u001b[27m\u001b[K\r\r\n\u001b[7m                print(\"Downloaded:\", name)\u001b[27m\u001b[K\r\r\n\u001b[7m        except:\u001b[27m\u001b[K\r\r\n\u001b[7m            pass\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.361, "o", "\u001b[22A\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mu\u001b[27mr\u001b[27ml\u001b[27m \u001b[27m=\u001b[27m \u001b[27mB\u001b[27mA\u001b[27mS\u001b[27mE\u001b[27m \u001b[27m+\u001b[27m \u001b[27m\"\u001b[27mc\u001b[27ma\u001b[27mu\u001b[27ms\u001b[27me\u001b[27ml\u001b[27mi\u001b[27ms\u001b[27mt\u001b[27m\"\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mr\u001b[27m \u001b[27m=\u001b[27m \u001b[27mr\u001b[27me\u001b[27mq\u001b[27mu\u001b[27me\u001b[27ms\u001b[27mt\u001b[27ms\u001b[27m.\u001b[27mg\u001b[27me\u001b[27mt\u001b[27m(\u001b[27mu\u001b[27mr\u001b[27ml\u001b[27m,\u001b[27m \u001b[27mt\u001b[27mi\u001b[27mm\u001b[27me\u001b[27mo\u001b[27mu\u001b[27mt\u001b[27m=\u001b[27m3\u001b[27m0\u001b[27m)\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27ms\u001b[27mo\u001b[27mu\u001b[27mp\u001b[27m \u001b[27m=\u001b[27m \u001b[27mB\u001b[27me\u001b[27ma\u001b[27mu\u001b[27mt\u001b[27mi\u001b[27mf\u001b[27mu\u001b[27ml\u001b[27mS\u001b[27mo\u001b[27mu\u001b[27mp\u001b[27m(\u001b[27mr\u001b[27m.\u001b[27mt\u001b[27me\u001b[27mx\u001b[27mt\u001b[27m,\u001b[27m \u001b[27m\"\u001b[27mh\u001b[27mt\u001b[27mm\u001b[27ml\u001b[27m.\u001b[27mp\u001b[27ma\u001b[27mr\u001b[27ms\u001b[27me\u001b[27mr\u001b[27m\"\u001b[27m)\u001b[2B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27ml\u001b[27mi\u001b[27mn\u001b[27mk\u001b[27ms\u001b[27m \u001b[27m=\u001b[27m \u001b[27m[\u001b[27m]\u001b[2B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mf\u001b[27mo\u001b[27mr\u001b[27m \u001b[27ma\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m \u001b[27ms\u001b[27mo\u001b[27mu\u001b[27mp\u001b[27m.\u001b[27mf\u001b[27mi\u001b[27mn\u001b[27md\u001b[27m_\u001b[27ma\u001b[27ml\u001b[27ml\u001b[27m(\u001b[27m\"\u001b[27ma\u001b[27m\"\u001b[27m,\u001b[27m \u001b[27mh\u001b[27mr\u001b[27me\u001b[27mf\u001b[27m=\u001b[27mT\u001b[27mr\u001b[27mu\u001b["]
