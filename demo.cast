[3.498, "o", "\u001b[7mcat << 'EOF' > app/orders.py\u001b[27m\r\r\n\u001b[7mfrom pathlib import Path\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mORDERS = Path(\"orders\")\u001b[27m\u001b[K\r\r\n\u001b[7mORDERS.mkdir(exist_ok=True)\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mdef list_orders():\u001b[27m\u001b[K\r\r\n\u001b[7m    return [f.name for f in ORDERS.glob(\"*\")]\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mdef summarize_order(name):\u001b[27m\u001b[K\r\r\n\u001b[7m    return {\u001b[27m\u001b[K\r\r\n\u001b[7m        \"summary\": \"Reply to be filed within 2 weeks.\",\u001b[27m\u001b[K\r\r\n\u001b[7m        \"risk\": \"Non-compliance may lead to dismissal.\",\u001b[27m\u001b[K\r\r\n\u001b[7m        \"next_step\": \"File affidavit\"\u001b[27m\u001b[K\r\r\n\u001b[7m    }\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.341, "o", "\u001b[15A\u001b[31C\u001b[27mc\u001b[27ma\u001b[27mt\u001b[27m \u001b[27m<\u001b[27m<\u001b[27m \u001b[27m'\u001b[27mE\u001b[27mO\u001b[27mF\u001b[27m'\u001b[27m \u001b[27m>\u001b[27m \u001b[27ma\u001b[27mp\u001b[27mp\u001b[27m/\u001b[27mo\u001b[27mr\u001b[27md\u001b[27me\u001b[27mr\u001b[27ms\u001b[27m.\u001b[27mp\u001b[27my\u001b[1B\r\u001b[27mf\u001b[27mr\u001b[27mo\u001b[27mm\u001b[27m \u001b[27mp\u001b[27ma\u001b[27mt\u001b[27mh\u001b[27ml\u001b[27mi\u001b[27mb\u001b[27m \u001b[27mi\u001b[27mm\u001b[27mp\u001b[27mo\u001b[27mr\u001b[27mt\u001b[27m \u001b[27mP\u001b[27ma\u001b[27mt\u001b[27mh\u001b[2B\r\u001b[27mO\u001b[27mR\u001b[27mD\u001b[27mE\u001b[27mR\u001b[27mS\u001b[27m \u001b[27m=\u001b[27m \u001b[27mP\u001b[27ma\u001b[27mt\u001b[27mh\u001b[27m(\u001b[27m\"\u001b[27mo\u001b[27mr\u001b[27md\u001b[27me\u001b[27mr\u001b[27ms\u001b[27m\"\u001b[27m)\u001b[1B\r\u001b[27mO\u001b[27mR\u001b[27mD\u001b[27mE\u001b[27mR\u001b[27mS\u001b[27m.\u001b[27mm\u001b[27mk\u001b[27md\u001b[27mi\u001b[27mr\u001b[27m(\u001b[27me\u001b[27mx\u001b[27mi\u001b[27ms\u001b[27mt\u001b[27m_\u001b[27mo\u001b[27mk\u001b[27m=\u001b[27mT\u001b[27mr\u001b[27mu\u001b[27me\u001b[27m)\u001b[2B\r\u001b[27md\u001b[27me\u001b[27mf\u001b[27m \u001b[27ml\u001b[27mi\u001b[27ms\u001b[27mt\u001b[27m_\u001b[27mo\u001b[27mr\u001b[27md\u001b[27me\u001b[27mr\u001b[27ms\u001b[27m(\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mr\u001b[27me\u001b[27mt\u001b[27mu\u001b[27mr\u001b[27mn\u001b[27m \u001b[27m[\u001b[27mf\u001b[27m.\u001b[27mn\u001b[27ma\u001b[27mm\u001b[27me\u001b[27m \u001b[27mf\u001b[27mo\u001b[27mr\u001b[27m \u001b[27mf\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m \u001b[27mO\u001b[27mR\u001b[27mD\u001b[27mE\u001b[27mR\u001b[27mS\u001b[27m.\u001b[27mg\u001b[27ml\u001b[27mo\u001b[27mb\u001b[27m(\u001b[27m\"\u001b[27m*\u001b[27m\"\u001b[27m)\u001b[27m"]
[0.000, "o", "]\u001b[2B\r\u001b[27md\u001b[27me\u001b[27mf\u001b[27m \u001b[27ms\u001b[27mu\u001b[27mm\u001b[27mm\u001b[27ma\u001b[27mr\u001b[27mi\u001b[27mz\u001b[27me\u001b[27m_\u001b[27mo\u001b[27mr\u001b[27md\u001b[27me\u001b[27mr\u001b[27m(\u001b[27mn\u001b[27ma\u001b[27mm\u001b[27me\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mr\u001b[27me\u001b[27mt\u001b[27mu\u001b[27mr\u001b[27mn\u001b[27m \u001b[27m{\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m\"\u001b[27ms\u001b[27mu\u001b[27mm\u001b[27mm\u001b[27ma\u001b[27mr\u001b[27my\u001b[27m\"\u001b[27m:\u001b[27m \u001b[27m\"\u001b[27mR\u001b[27me\u001b[27mp\u001b[27ml\u001b[27my\u001b[27m \u001b[27mt\u001b[27mo\u001b[27m \u001b[27mb\u001b[27me\u001b[27m \u001b[27mf\u001b[27mi\u001b[27ml\u001b[27me\u001b[27md\u001b[27m \u001b[27mw\u001b[27mi\u001b[27mt\u001b[27mh\u001b[27mi\u001b[27mn\u001b[27m \u001b[27m2\u001b[27m \u001b[27mw\u001b[27me\u001b[27me\u001b[27mk\u001b[27ms\u001b[27m.\u001b[27m\"\u001b[27m,\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m\"\u001b[27mr\u001b[27mi\u001b[27ms\u001b[27mk\u001b[27m\"\u001b[27m:\u001b[27m \u001b[27m\"\u001b[27mN\u001b[27mo\u001b[27mn\u001b[27m-\u001b[27mc\u001b[27mo\u001b[27mm\u001b[27mp\u001b[27ml\u001b[27mi\u001b[27ma\u001b[27mn\u001b[27mc\u001b[27me\u001b[27m \u001b[27mm\u001b[27ma\u001b[27my\u001b[27m \u001b[27ml\u001b[27me\u001b[27ma\u001b[27md\u001b[27m \u001b[27mt\u001b[27mo\u001b[27m \u001b[27md\u001b[27mi\u001b[27ms\u001b[27mm\u001b[27mi\u001b[27ms\u001b[27ms\u001b[27ma\u001b[27ml\u001b[27m.\u001b[27m\"\u001b[27m,\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m\"\u001b[27mn\u001b[27me\u001b[27mx\u001b[27mt\u001b[27m_\u001b[27ms\u001b[27mt\u001b[27me\u001b["]
