[12.790, "o", ">....                                         \r\n\u001b[7m    for days_left, case_no, status in upcoming:\u001b[27m\u001b[K\r\r\n\u001b[7m        if days_left == 0:\u001b[27m\u001b[K\r\r\n\u001b[7m            typer.echo(f\"🚨 TODAY: {case_no}\")\u001b[27m\u001b[K\r\r\n\u001b[7m        elif days_left <= 2:\u001b[27m\u001b[K\r\r\n\u001b[7m            typer.echo(f\"⚠ {case_no} in {days_left} days\")\u001b[27m\u001b[K\r\r\n\u001b[7m        else:\u001b[27m\u001b[K\r\r\n\u001b[7m            typer.echo(f\"{case_no} in {days_left} days\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m        typer.echo(f\"   Judge: {status['judge']}\")\u001b[27m\u001b[K\r\r\n\u001b[7m        typer.echo(f\"   Stage: {status['stage']}\")\u001b[27m\u001b[K\r\r\n\u001b[7m        typer.echo(\"\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    typer.echo(\"✔ Brief complete.\\n\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m@app.command()\u001b[27m\u001b[K\r\r\n\u001b[7mdef version():\u001b[27m\u001b[K\r\r\n\u001b[7m    typer.echo(\"VC v0.3\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mif __name__ == \"__main__\":\u001b[27m\u001b[K\r\r\n\u001b[7m    app()\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.548, "o", "\u001b[22A\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mf\u001b[27mo\u001b[27mr\u001b[27m \u001b[27md\u001b[27ma\u001b[27my\u001b[27ms\u001b[27m_\u001b[27ml\u001b[27me\u001b[27mf\u001b[27mt\u001b[27m,\u001b[27m \u001b[27mc\u001b[27ma\u001b[27ms\u001b[27me\u001b[27m_\u001b[27mn\u001b[27mo\u001b[27m,\u001b[27m \u001b[27ms\u001b[27mt\u001b[27ma\u001b[27mt\u001b[27mu\u001b[27ms\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m \u001b[27mu\u001b[27mp\u001b[27mc\u001b[27mo\u001b[27mm\u001b[27mi\u001b[27mn\u001b[27mg\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mi\u001b[27mf\u001b[27m \u001b[27md\u001b[27ma\u001b[27my\u001b[27ms\u001b[27m_\u001b[27ml\u001b[27me\u001b[27mf\u001b[27mt\u001b[27m \u001b[27m=\u001b[27m=\u001b[27m \u001b[27m0\u001b[27m:\u001b[1B\r\u001b[46P\u001b[12Ctyper.echo(f\"🚨 TODAY: {case_no}\")\u001b[K\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27me\u001b[27ml\u001b[27mi\u001b[27mf\u001b[27m \u001b[27md\u001b[27ma\u001b[27my\u001b[27ms\u001b[27m_\u001b[27ml\u001b[27me\u001b[27mf\u001b[27mt\u001b[27m \u001b[27m<\u001b[27m=\u001b[27m \u001b[27m2\u001b[27m:\u001b[1B\r\u001b[58P\u001b[12Ctyper.echo(f\"⚠ {case_no} in {days_left} days\")\u001b[K\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27me\u001b[27ml\u001b[27ms\u001b[27me\u001b[27m:\u001b[1B\r\u001b[56P\u001b[12Ctyper.echo(f\"{case_no} in {days_left} days\")\u001b[K\u001b[2B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mt\u001b[27my\u001b[27mp\u001b[27me\u001b[27mr\u001b[27m.\u001b[27me\u001b[27mc\u001b[27mh\u001b[27mo\u001b[27m(\u001b[27mf\u001b[27m\"\u001b[27m "]
[0.000, "o", "\u001b[27m \u001b[27m \u001b[27mJ\u001b[27mu\u001b[27md\u001b[27mg\u001b[27me\u001b[27m:\u001b[27m \u001b[27m{\u001b[27ms\u001b[27mt\u001b[27ma\u001b[27mt\u001b[27mu\u001b[27ms\u001b[27m[\u001b[27m'\u001b[27mj\u001b[27mu\u001b[27md\u001b[27mg\u001b[27me\u001b[27m'\u001b[27m]\u001b[27m}\u001b[27m\"\u001b[27m)\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mt\u001b[27my\u001b[27mp\u001b[27me\u001b[27mr\u001b[27m.\u001b[27me\u001b[27mc\u001b[27mh\u001b[27mo\u001b[27m(\u001b[27mf\u001b[27m\"\u001b[27m \u001b[27m \u001b[27m \u001b[27mS\u001b[27mt\u001b[27ma\u001b[27mg\u001b[27me\u001b[27m:\u001b[27m \u001b[27m{\u001b[27ms\u001b[27mt\u001b[27ma\u001b[27mt\u001b[27mu\u001b[27ms\u001b[27m[\u001b[27m'\u001b[27ms\u001b[27mt\u001b[27ma\u001b[27mg\u001b[27me\u001b[27m'\u001b[27m]\u001b[27m}\u001b[27m\"\u001b[27m)\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mt\u001b[27my\u001b[27mp\u001b[27me\u001b[27mr\u001b[27m.\u001b[27me\u001b[27mc\u001b[27mh\u001b[27mo\u001b[27m(\u001b[27m\"\u001b[27m\"\u001b[27m)\u001b[2B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mt\u001b[27my\u001b[27mp\u001b[27me\u001b[27mr\u001b[27m.\u001b[27me\u001b[27mc\u001b[27mh\u001b[27mo\u001b[27m(\u001b[27m\"\u001b[27m✔\u001b[27m \u001b[27mB\u001b[27mr\u001b[27mi\u001b[27me\u001b[27mf\u001b[27m \u001b[27mc\u001b[27mo\u001b[27mm\u001b[27mp\u001b[27ml\u001b[27me\u001b[27mt\u001b[27me\u001b[27m.\u001b[27m\\\u001b[27mn\u001b[27m\"\u001b[27m)\u001b[3B\r\u001b[27m@\u001b[27ma\u001b[27mp\u001b[27mp\u001b[27m.\u001b[27mc\u001b[27mo\u001b[27mm\u001b[27mm\u001b[27ma\u001b[27mn\u001b[27md\u001b[27m(\u001b[27m)\u001b[1B\r\u001b[27md\u001b[27me\u001b[27mf\u001b[27m \u001b[27mv\u001b[27me\u001b[27mr\u001b[27ms\u001b[27mi\u001b[27mo\u001b[27mn\u001b[27m(\u001b[27m)\u001b[27m:\u001b[1B\r\u001b["]
