[557.823, "o", ">....                                         \r\n\u001b[K\r\r\n\u001b[7mdef scan_pdf(file):\u001b[27m\u001b[K\r\r\n\u001b[7m    with pdfplumber.open(file) as pdf:\u001b[27m\u001b[K\r\r\n\u001b[7m        for page_no, page in enumerate(pdf.pages, start=1):\u001b[27m\u001b[K\r\r\n\u001b[7m            text = page.extract_text() or \"\"\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m            if CASE_NUMBER in text:\u001b[27m\u001b[K\r\r\n\u001b[7m                print(f\"\\n✅ FOUND in {file}\")\u001b[27m\u001b[K\r\r\n\u001b[7m                print(f\"Page: {page_no}\")\u001b[27m\u001b[K\r\r\n\u001b[7m                print(text[:300])\u001b[27m\u001b[K\r\r\n\u001b[7m                return True\u001b[27m\u001b[K\r\r\n\u001b[7m    return False\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mpdfs = Path(\".\").glob(\"*.pdf\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mfound = False\u001b[27m\u001b[K\r\r\n\u001b[7mfor pdf in pdfs:\u001b[27m\u001b[K\r\r\n\u001b[7m    if scan_pdf(pdf):\u001b[27m\u001b[K\r\r\n\u001b[7m        found = True\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mif not found:\u001b[27m\u001b[K\r\r\n\u001b[7m    print(\"\\n❌ Case not listed today\")\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.322, "o", "\u001b[21A\r\u001b[27md\u001b[27me\u001b[27mf\u001b[27m \u001b[27ms\u001b[27mc\u001b[27ma\u001b[27mn\u001b[27m_\u001b[27mp\u001b[27md\u001b[27mf\u001b[27m(\u001b[27mf\u001b[27mi\u001b[27ml\u001b[27me\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mw\u001b[27mi\u001b[27mt\u001b[27mh\u001b[27m \u001b[27mp\u001b[27md\u001b[27mf\u001b[27mp\u001b[27ml\u001b[27mu\u001b[27mm\u001b[27mb\u001b[27me\u001b[27mr\u001b[27m.\u001b[27mo\u001b[27mp\u001b[27me\u001b[27mn\u001b[27m(\u001b[27mf\u001b[27mi\u001b[27ml\u001b[27me\u001b[27m)\u001b[27m \u001b[27ma\u001b[27ms\u001b[27m \u001b[27mp\u001b[27md\u001b[27mf\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mf\u001b[27mo\u001b[27mr\u001b[27m \u001b[27mp\u001b[27ma\u001b[27mg\u001b[27me\u001b[27m_\u001b[27mn\u001b[27mo\u001b[27m,\u001b[27m \u001b[27mp\u001b[27ma\u001b[27mg\u001b[27me\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m \u001b[27me\u001b[27mn\u001b[27mu\u001b[27mm\u001b[27me\u001b[27mr\u001b[27ma\u001b[27mt\u001b[27me\u001b[27m(\u001b[27mp\u001b[27md\u001b[27mf\u001b[27m.\u001b[27mp\u001b[27ma\u001b[27mg\u001b[27me\u001b[27ms\u001b[27m,\u001b[27m \u001b[27ms\u001b[27mt\u001b[27ma\u001b[27mr\u001b[27mt\u001b[27m=\u001b[27m1\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[44P\u001b[12Ctext = page.extract_text() or \"\"\u001b[K\u001b[2B\r\u001b[35P\u001b[12Cif CASE_NUMBER in text:\u001b[10C\u001b[K\u001b[1B\r\u001b[46P\u001b[16Cprint(f\"\\n✅ FOUND in {file}\")\u001b[K\u001b[1B\r\u001b[41P\u001b[16Cprint(f\"Page: {page_no}\")\u001b[K\u001b[1B\r\u001b[33P\u001b[16Cprint(text[:300])\u001b[14C\u001b[K\u001b[1B\r\u001b[27P\u001b[16Creturn True\u001b[26C\u001b[K\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mr\u001b[27me\u001b[27mt\u001b[2"]
