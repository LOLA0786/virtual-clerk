[48.599, "o", ">....                                         \r\n\u001b[K\r\r\n\u001b[7mdef fetch_bench_pdfs():\u001b[27m\u001b[K\r\r\n\u001b[7m    downloaded = 0\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    for url in URLS:\u001b[27m\u001b[K\r\r\n\u001b[7m        try:\u001b[27m\u001b[K\r\r\n\u001b[7m            name = url.split(\"/\")[-1]\u001b[27m\u001b[K\r\r\n\u001b[7m            path = SAVE / name\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m            r = requests.get(url, timeout=20)\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m            if r.status_code == 200 and r.headers.get(\"content-type\",\"\").startsw\u001b[7mi\u001b[7mth(\"application/pdf\"):\u001b[27m\u001b[K\r\r\n\u001b[7m                path.write_bytes(r.content)\u001b[27m\u001b[K\r\r\n\u001b[7m                downloaded += 1\u001b[27m\u001b[K\r\r\n\u001b[7m                print(\"Downloaded:\", name)\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m        except:\u001b[27m\u001b[K\r\r\n\u001b[7m            pass\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    if downloaded == 0:\u001b[27m\u001b[K\r\r\n\u001b[7m        print(\"⚠ No PDFs downloaded\")\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.331, "o", "\u001b[21A\r\u001b[27md\u001b[27me\u001b[27mf\u001b[27m \u001b[27mf\u001b[27me\u001b[27mt\u001b[27mc\u001b[27mh\u001b[27m_\u001b[27mb\u001b[27me\u001b[27mn\u001b[27mc\u001b[27mh\u001b[27m_\u001b[27mp\u001b[27md\u001b[27mf\u001b[27ms\u001b[27m(\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27md\u001b[27mo\u001b[27mw\u001b[27mn\u001b[27ml\u001b[27mo\u001b[27ma\u001b[27md\u001b[27me\u001b[27md\u001b[27m \u001b[27m=\u001b[27m \u001b[27m0\u001b[2B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mf\u001b[27mo\u001b[27mr\u001b[27m \u001b[27mu\u001b[27mr\u001b[27ml\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m \u001b[27mU\u001b[27mR\u001b[27mL\u001b[27mS\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mt\u001b[27mr\u001b[27my\u001b[27m:\u001b[1B\r\u001b[37P\u001b[12Cname = url.split(\"/\")[-1]\u001b[6C\u001b[K\u001b[1B\r\u001b[30P\u001b[12Cpath = SAVE / name\u001b[20C\u001b[K\u001b[2B\r\u001b[45P\u001b[12Cr = requests.get(url, timeout=20)\u001b[K\u001b[2B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mi\u001b[27mf\u001b[27m \u001b[27mr\u001b[27m.\u001b[27ms\u001b[27mt\u001b[27ma\u001b[27mt\u001b[27mu\u001b[27ms\u001b[27m_\u001b[27mc\u001b[27mo\u001b[27md\u001b[27me\u001b[27m \u001b[27m=\u001b[27m=\u001b[27m \u001b[27m2\u001b[27m0\u001b[27m0\u001b[27m \u001b[27ma\u001b[27mn\u001b[27md\u001b[27m \u001b[27mr\u001b[27m.\u001b[27mh\u001b[27me\u001b[27ma\u001b[27md\u001b[27me\u001b[27mr\u001b[27ms\u001b[27m.\u001b[27mg\u001b[27me\u001b[27mt\u001b[27m(\u001b[27m\"\u001b[27mc\u001b[27mo\u001b[27mn\u001b[27mt\u001b[27me\u001b[27mn\u001b[27mt\u001b[27m-\u001b[27mt\u001b[27my\u001b[27mp\u001b[27me\u001b[27m\"\u001b[27m,\u001b[27m\"\u001b"]
[0.000, "o", "[27m\"\u001b[27m)\u001b[27m.\u001b[27ms\u001b[27mt\u001b[27ma\u001b[27mr\u001b[27mt\u001b[27ms\u001b[27mwi\u001b[27mt\u001b[27mh\u001b[27m(\u001b[27m\"\u001b[27ma\u001b[27mp\u001b[27mp\u001b[27ml\u001b[27mi\u001b[27mc\u001b[27ma\u001b[27mt\u001b[27mi\u001b[27mo\u001b[27mn\u001b[27m/\u001b[27mp\u001b[27md\u001b[27mf\u001b[27m\"\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[43P\u001b[16Cpath.write_bytes(r.content)\u001b[K\u001b[1B\r\u001b[31P\u001b[16Cdownloaded += 1\u001b[18C\u001b[K\u001b[1B\r\u001b[M\u001b[16Cprint(\"Downloaded:\", name)\u001b[1B\r\u001b[K\u001b[1B\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27me\u001b[27mx\u001b[27mc\u001b[27me\u001b[27mp\u001b[27mt\u001b[27m:\u001b[K\u001b[1B\b\b\bpass\u001b[1B\r\u001b[K\u001b[1B\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mi\u001b[27mf\u001b[27m \u001b[27md\u001b[27mo\u001b[27mw\u001b[27mn\u001b[27ml\u001b[27mo\u001b[27ma\u001b[27md\u001b[27me\u001b[27md\u001b[27m \u001b[27m=\u001b[27m=\u001b[27m \u001b[27m0\u001b[27m:\u001b[K\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[5Cprint(\"⚠ No PDFs downloaded\")\u001b[1B\rEOF\u001b[K"]
