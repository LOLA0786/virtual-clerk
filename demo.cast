[216.819, "o", "\u001b[7mcat << 'EOF' > app/listing.py\u001b[27m\r\r\n\u001b[7mfrom pathlib import Path\u001b[27m\u001b[K\r\r\n\u001b[7mfrom app.sequence_extract import find_sequence\u001b[27m\u001b[K\r\r\n\u001b[7mfrom app.bench_extract import extract_bench_info\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mPDF_DIR = Path(\"benches\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mdef find_listing(case_number):\u001b[27m\u001b[K\r\r\n\u001b[7m    results = []\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    for pdf in PDF_DIR.glob(\"*.pdf\"):\u001b[27m\u001b[K\r\r\n\u001b[7m        seq = find_sequence(pdf, case_number)\u001b[27m\u001b[K\r\r\n\u001b[7m        if seq:\u001b[27m\u001b[K\r\r\n\u001b[7m            bench = extract_bench_info(pdf)\u001b[27m\u001b[K\r\r\n\u001b[7m            results.append({\u001b[27m\u001b[K\r\r\n\u001b[7m                \"file\": pdf.name,\u001b[27m\u001b[K\r\r\n\u001b[7m                \"sequence\": seq[\"sequence\"],\u001b[27m\u001b[K\r\r\n\u001b[7m                \"line\": seq[\"line\"],\u001b[27m\u001b[K\r\r\n\u001b[7m                \"bench\": bench\u001b[27m\u001b[K\r\r\n\u001b[7m            })\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    return results\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.695, "o", "\u001b[22A\u001b[31C\u001b[27mc\u001b[27ma\u001b[27mt\u001b[27m \u001b[27m<\u001b[27m<\u001b[27m \u001b[27m'\u001b[27mE\u001b[27mO\u001b[27mF\u001b[27m'\u001b[27m \u001b[27m>\u001b[27m \u001b[27ma\u001b[27mp\u001b[27mp\u001b[27m/\u001b[27ml\u001b[27mi\u001b[27ms\u001b[27mt\u001b[27mi\u001b[27mn\u001b[27mg\u001b[27m.\u001b[27mp\u001b[27my\u001b[1B\r\u001b[27mf\u001b[27mr\u001b[27mo\u001b[27mm\u001b[27m \u001b[27mp\u001b[27ma\u001b[27mt\u001b[27mh\u001b[27ml\u001b[27mi\u001b[27mb\u001b[27m \u001b[27mi\u001b[27mm\u001b[27mp\u001b[27mo\u001b[27mr\u001b[27mt\u001b[27m \u001b[27mP\u001b[27ma\u001b[27mt\u001b[27mh\u001b[1B\r\u001b[27mf\u001b[27mr\u001b[27mo\u001b[27mm\u001b[27m \u001b[27ma\u001b[27mp\u001b[27mp\u001b[27m.\u001b[27ms\u001b[27me\u001b[27mq\u001b[27mu\u001b[27me\u001b[27mn\u001b[27mc\u001b[27me\u001b[27m_\u001b[27me\u001b[27mx\u001b[27mt\u001b[27mr\u001b[27ma\u001b[27mc\u001b[27mt\u001b[27m \u001b[27mi\u001b[27mm\u001b[27mp\u001b[27mo\u001b[27mr\u001b[27mt\u001b[27m \u001b[27mf\u001b[27mi\u001b[27mn\u001b[27md\u001b[27m_\u001b[27ms\u001b[27me\u001b[27mq\u001b[27mu\u001b[27me\u001b[27mn\u001b[27mc\u001b[27me\u001b[1B\r\u001b[27mf\u001b[27mr\u001b[27mo\u001b[27mm\u001b[27m \u001b[27ma\u001b[27mp\u001b[27mp\u001b[27m.\u001b[27mb\u001b[27me\u001b[27mn\u001b[27mc\u001b[27mh\u001b[27m_\u001b[27me\u001b[27mx\u001b[27mt\u001b[27mr\u001b[27ma\u001b[27mc\u001b[27mt\u001b[27m \u001b[27mi\u001b[27mm\u001b[27mp\u001b[27mo\u001b[27mr\u001b[27mt\u001b[27m \u001b[27me\u001b[27mx\u001b[27mt\u001b[27mr\u001b[27ma\u001b[27mc\u001b[27mt\u001b[27m_\u001b[27mb\u001b[27me\u001b[27mn\u001b[27mc\u001b[27mh\u001b[27m_\u001b[27mi\u001b[27mn\u001b[27mf\u001b[27mo\u001b[2B\r\u001b[27mP\u001b[27mD\u001b[27mF\u001b[27m_\u001b[27mD\u001b[27mI\u001b[27mR\u001b[27m \u001b[27m=\u001b[27m \u001b[27mP\u001b[27ma\u001b[27mt\u001b[27mh\u001b[27m(\u001b[27m\"\u001b[27mb\u001b[27me\u001b[27"]
